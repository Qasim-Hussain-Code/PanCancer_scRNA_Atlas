*.7z filter=lfs diff=lfs merge=lfs -text
*.rds filter=lfs diff=lfs merge=lfs -text
*.h5seurat filter=lfs diff=lfs merge=lfs -text
*.h5ad filter=lfs diff=lfs merge=lfs -text

# Exclude iframe figures from HTML stats
iframe_figures/** linguist-generated=true
iframe_figures/** linguist-documentation=true
**/*.html linguist-detectable=false

# Map Jupyter Notebooks directly to R (Seurat pipeline)
**/*.ipynb linguist-language=R

# Ignore utility Python scripts from language breakdown
*.py linguist-detectable=false
scripts/*.py linguist-detectable=false
